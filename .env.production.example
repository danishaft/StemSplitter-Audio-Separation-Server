APP_ENV=production
INSTANCE_ID=api-1
APP_VERSION=replace-with-git-sha
PUBLIC_API_URL=https://splitter.example/api
TRUSTED_HOSTS=replace-with-azure-container-app.azurecontainerapps.io
EDGE_MODE=cloudflare
EDGE_VERIFY_HEADER=X-StemSplitter-Origin-Verify
EDGE_VERIFY_SECRET=replace-with-at-least-32-random-characters
DEFAULT_PROFILE=quality_gpu_experimental
ALLOW_EVALUATION_PROFILES=1
CORS_ALLOWED_ORIGINS=https://splitter.example
ALLOW_MULTIPART_UPLOADS=0
RATE_LIMIT_ENABLED=1
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_MUTATIONS_PER_MINUTE=20
RATE_LIMIT_NAMESPACE=stemsplitter:rate
METRICS_BEARER_TOKEN=replace-me

DATABASE_URL=postgresql://user:password@host:5432/stemsplitter?sslmode=require
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT=10
JOB_STORE_BACKEND=postgres
REDIS_URL=rediss://user:password@host:6379/0
JOB_DISPATCH_BACKEND=rq
JOB_QUEUE_NAME=stemsplitter
JOB_LEASE_SECONDS=3900
JOB_LEASE_RENEW_INTERVAL=1300
JOB_MAX_ATTEMPTS=3
JOB_RETRY_INTERVALS=10,30
JOB_MAX_ACTIVE=100
JOB_MAX_ACTIVE_PER_OWNER=5
JOB_EXECUTION_TIMEOUT=3900
JOB_RESULT_TTL=86400
JOB_FAILURE_TTL=604800
JOB_RETENTION_SECONDS=604800
JOB_RECONCILE_STALE_SECONDS=300
MAINTENANCE_INTERVAL_SECONDS=60

AUTH_MODE=jwt
AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
AUTH_ISSUER=https://identity.example/
AUTH_AUDIENCE=stemsplitter-api
AUTH_ALGORITHMS=ES256

# Configure Azure Monitor, generic OTLP, Sentry, or a combination.
APPLICATIONINSIGHTS_CONNECTION_STRING=replace-with-azure-monitor-connection
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=stemsplitter-api
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_BUCKET=private-audio
OBJECT_STORAGE_PREFIX=stemsplitter
OBJECT_STORAGE_ENDPOINT_URL=https://s3.example
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE_MODAL_SECRET=stemsplitter-b2
OBJECT_STORAGE_PRESIGN_TTL=900
OBJECT_STORAGE_MAX_BYTES=524288000

GPU_WORKER_URL=https://replace-with-modal-endpoint
GPU_WORKER_API_KEY=replace-me
GPU_WORKER_MAX_EXECUTION_SECONDS=300

# Optional hosted MVSep specialist lane. Only used by
# quality_mvsep_experimental; leave unset for the default local/GPU paths.
MVSEP_API_BASE_URL=https://de2.mvsep.com/api
MVSEP_API_KEY=replace-me
MVSEP_TIMEOUT=300
MVSEP_MAX_RETRIES=3
MVSEP_POLL_INTERVAL=5
MVSEP_MAX_POLLS=720

WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=60
