{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stemsplitter-web",
  "main": "./worker.js",
  "compatibility_date": "2026-07-30",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "API_ORIGIN": "https://replace-with-azure-container-app"
  }
}
