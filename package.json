{
  "name": "stemsplitter",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "api:generate": "turbo run api:generate",
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "deploy:web": "pnpm --filter @stemsplitter/web deploy",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
