{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stemsplitter-web",
  "main": "worker.ts",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "out",
    "run_worker_first": true
  },
  "vars": {
    "API_ORIGIN": "https://replace-with-azure-container-app"
  }
}
